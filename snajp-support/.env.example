# Snajp-Support backend
# Kopiera till .env och fyll i.

# LLM-provider: "openai" eller "deepseek" (OpenAI-kompatibel endpoint).
LLM_PROVIDER=openai
# Tom => härleds från provider (deepseek => https://api.deepseek.com). Sätt bara vid egen proxy.
LLM_BASE_URL=

# Nyckel för aktiv provider (platshållare/tom => simuleringsläge).
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=

# Modell. openai => gpt-4o-mini, deepseek => deepseek-v4-flash (auto om gpt-default lämnas).
MODEL=gpt-4o-mini

# Gemini (Google AI Studio, gratisnivå) — driver vision-sidovagnen och
# embeddings. Skaffa nyckel: https://aistudio.google.com/apikey
# Sätts enklast med: python scripts/keys.py
GEMINI_API_KEY=

# G9: vision-sidovagn (beskriver bilder separat — DeepSeek saknar dokumenterat
# bildstöd). Kräver samma nyckel som EMBEDDING_API_KEY/GEMINI_API_KEY.
VISION_MODEL=gemini-3.6-flash

# Embeddings går mot Gemini (DeepSeek saknar embeddings-endpoint).
# Tom => faller tillbaka på GEMINI_API_KEY; saknas båda => full-text-fallback i KB.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Postgres (Supabase pooler). Lämna tom => in-memory-lagring (demo-läge).
# Format: postgresql://postgres.<projectref>:<SUPABASE_DB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Redis (valfritt; saknas => in-memory jobbkö).
# HELA URL:en krävs — enbart host:port ger ValueError i redis-klienten,
# vilket main.py fångar och tyst faller tillbaka till in-memory med.
# Format: redis://default:<lösenord>@<host>:<port>   (rediss:// med TLS)
# Kräver paketet redis i requirements.txt; utan det spelar värdet ingen roll.
REDIS_URL=

# API-nycklar
SNAJP_MASTER_API_KEY=snajp_master_dev_key_change_me
SNAJP_DEMO_API_KEY=snajp_demo_2f8c1a9e4b7d

# --- Email-pipeline (inkorg → triage → utkast/autosvar) ---

# Bakgrundspolling av IMAP-inkorgen. 0 = av (mock/ingest triggas manuellt).
# Minsta faktiska intervall är 30 s även om ett lägre värde sätts.
INBOX_POLL_SECONDS=0

# Autosvar kräver konfidens >= detta värde (och regeln 'auto' + ej negativt sentiment).
AUTO_SEND_MIN_CONFIDENCE=0.75

# IMAP — riktig inkorg. Gmail: imap.gmail.com + app-lösenord.
# Microsoft 365/Outlook: outlook.office365.com. Lämna tomt => ingen IMAP.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Utgående SMTP — KUNDVÄND sändväg (leads-utskick + godkända supportsvar).
# Alla tre första måste vara satta, annars väljs LoggingSendProvider och
# ingenting skickas (syns som "Ingen riktig sändväg" i /health/ready).
# Port 465 = implicit TLS, allt annat STARTTLS. Lösenordet är ett
# app-lösenord. SMTP_FROM tom => SMTP_USER. Skild från INTERNLARM_SMTP_*
# (de två vägarna får aldrig dela konto — se notifications/prioriterat_mejl.py).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# Kanal: "smtp" eller "resend". Tomt => resend om RESEND_API_KEY finns,
# annars smtp. HTTPS-vägen behövs eftersom Railway blockerar utgående SMTP
# på Free/Trial/Hobby (bara Pro släpper igenom) — samma sak som Render gör.
# SMTP_FROM/SMTP_FROM_NAME styr avsändaren i BÅDA vägarna.
EMAIL_PROVIDER=
RESEND_API_KEY=
