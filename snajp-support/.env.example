# Snajp-Support backend
# Kopiera till .env och fyll i.

# LLM-provider: "openai" eller "deepseek" (OpenAI-kompatibel endpoint).
LLM_PROVIDER=openai
# Tom => härleds från provider (deepseek => https://api.deepseek.com). Sätt bara vid egen proxy.
LLM_BASE_URL=

# Nyckel för aktiv provider (platshållare/tom => simuleringsläge).
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=

# Modell. openai => gpt-4o-mini, deepseek => deepseek-chat (auto om gpt-default lämnas).
MODEL=gpt-4o-mini

# Embeddings går ALLTID mot OpenAI (DeepSeek saknar embeddings-endpoint).
# Tom när provider=deepseek => vektorsökning av => full-text-fallback i KB.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Postgres (Supabase pooler). Lämna tom => in-memory-lagring (demo-läge).
# Format: postgresql://postgres.<projectref>:<SUPABASE_DB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Redis (valfritt; saknas => in-memory jobbkö)
REDIS_URL=

# API-nycklar
SNAJP_MASTER_API_KEY=snajp_master_dev_key_change_me
SNAJP_DEMO_API_KEY=snajp_demo_2f8c1a9e4b7d

# --- Email-pipeline (inkorg → triage → utkast/autosvar) ---

# Bakgrundspolling av IMAP-inkorgen. 0 = av (mock/ingest triggas manuellt).
# Minsta faktiska intervall är 30 s även om ett lägre värde sätts.
INBOX_POLL_SECONDS=0

# Autosvar kräver konfidens >= detta värde (och regeln 'auto' + ej negativt sentiment).
AUTO_SEND_MIN_CONFIDENCE=0.75

# IMAP — riktig inkorg. Gmail: imap.gmail.com + app-lösenord.
# Microsoft 365/Outlook: outlook.office365.com. Lämna tomt => ingen IMAP.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Utgående svar (SMTP). Lämna tomt => ärver IMAP-kontot ovan
# (imap.gmail.com => smtp.gmail.com, outlook.office365.com => smtp.office365.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Avsändarnamn kunden ser i sin inkorg.
SMTP_FROM_NAME=Kundtjänst

# HÅRD SPÄRR mot autosvar. false = inget lämnar systemet utan mänskligt
# godkännande, oavsett vad kategorireglerna säger. Håll false under pilot.
ALLOW_AUTO_SEND=false
