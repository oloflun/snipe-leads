{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3005,
      "autoPort": true
    },
    {
      "name": "support-sajt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "cwd": "support-webb",
      "port": 3102
    },
    {
      "name": "leads",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "cwd": "leads-webb",
      "port": 3101
    },
    {
      "name": "bokforing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "cwd": "bokforing-webb",
      "port": 3100
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "cwd": "snajp-support",
      "port": 8000
    }
  ]
}
