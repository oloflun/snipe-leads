# Driftjobben hos Railway: synken (tjänsten synk i miljön main) och
# migrationskedjan (tjänsten migrera, en per miljö).
# docs/compliance/synkflytt-plan.md steg 4, runbooken synkflytt-runbook.md.
#
# Byggkontexten är repo-roten, som för api. Allowlisten bor i
# railway/Dockerfile.drift.dockerignore (BuildKit läser
# <Dockerfile>.dockerignore före rotens fil), så avbilden får bara skripten
# nedan, migrationerna och 000_auth_compat.sql. Inga hemligheter: anslutningarna
# kommer ur tjänstens variabler vid körning.
#
# Layouten under /srv speglar repot, eftersom railway_migrate räknar
# REPO_ROOT = Path(__file__).parents[1] och hittar supabase/migrations därifrån.
#
# Befintliga tjänster påverkas inte: ingen av dem bygger med den här filen, och
# rotens .dockerignore och snajp-support/Dockerfile är orörda.
FROM public.ecr.aws/docker/library/python:3.12-slim

WORKDIR /srv

RUN pip install --no-cache-dir "psycopg2-binary==2.9.10"

COPY scripts/railway_drift.py scripts/railway_synk.py scripts/railway_migrate.py scripts/railway_provision.py scripts/railway.py ./scripts/
COPY railway/000_auth_compat.sql ./railway/000_auth_compat.sql
COPY supabase/migrations ./supabase/migrations

ENV PYTHONUTF8=1
ENV LANG=C.UTF-8
ENV PYTHONUNBUFFERED=1

# Startkommandot sätts per tjänst hos Railway: `python scripts/railway_drift.py
# synk` eller `... migrera`. Utan jobb vägrar avbilden, så att en tjänst som
# saknar startkommando aldrig kör något av misstag.
CMD ["python", "scripts/railway_drift.py"]
