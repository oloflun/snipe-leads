# Copy to .env.local and fill in values from your Supabase project dashboard.
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for auth redirects (local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LLM (Email Studio agent — server-side only)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_REFINE_MODEL=deepseek-chat
LLM_GENERATE_MODEL=deepseek-chat