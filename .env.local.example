# Copy to .env.local and fill in values from your Supabase project dashboard.
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://spsmblyvasagpekjmgmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-J_VNDVbabHeLfrTw4rx7g_yqrX86gZ
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Site URL for auth redirects (local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LLM (Email Studio agent — server-side only)
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=
OPENAI_API_KEY=sk-...
LLM_REFINE_MODEL=gpt-4o-mini
LLM_GENERATE_MODEL=gpt-4o-mini

# Snajp-Support-backend (FastAPI på Render). Proxy: app/api/snajp-support/*.
# Lokalt: http://127.0.0.1:8000. Deployad: https://<render-url>.
SNAJP_SUPPORT_URL=http://127.0.0.1:8000
# Måste matcha backendens SNAJP_DEMO_API_KEY.
SNAJP_INTERNAL_API_KEY=snajp_demo_2f8c1a9e4b7d

# En API-nyckel per kund. Nyckeln avgör vilken tenant supportbackenden skriver
# till — saknas den faller kunden tillbaka på demo-tenanten och skriver alltså i
# fel kunds data. Skapas med POST /api/keys mot backenden (kräver master-nyckel).
SNAJP_KEY_LIVRUSTNING=

# Backenden (Render), inte Next-appen: IMAP-lösenord per kund. Kundens
# app-lösenord — ligger medvetet i env och aldrig i databasen.
# IMAP_PASSWORD_LIVRUSTNING=