# Copy to .env.local and fill in values from your Supabase project dashboard.
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://spsmblyvasagpekjmgmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-J_VNDVbabHeLfrTw4rx7g_yqrX86gZ
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Bygger länken i bekräftelse- och lösenordsåterställningsmail
# (${SITE}/auth/callback). Måste finnas på Supabase Auth → URL Configuration →
# Redirect URLs, annars avvisas länken. Produktion: https://snajp.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LLM (Email Studio agent — server-side only)
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=
OPENAI_API_KEY=sk-...
LLM_REFINE_MODEL=gpt-4o-mini
LLM_GENERATE_MODEL=gpt-4o-mini

# Snajp-Support-backend (FastAPI på Render). Proxy: app/api/snajp-support/*.
# Lokalt: http://127.0.0.1:8000. Deployad: https://<render-url>.
SNAJP_SUPPORT_URL=http://127.0.0.1:8000
# Demo-tenantens nyckel. Används av den PUBLIKA demon (/demo/snajp) och måste
# matcha backendens SNAJP_DEMO_API_KEY.
SNAJP_INTERNAL_API_KEY=snajp_demo_2f8c1a9e4b7d
# Administrativ nyckel — måste matcha backendens SNAJP_MASTER_API_KEY. Utan den
# kan inloggade kunder inte få en egen arbetsyta: proxyn svarar 503 i stället
# för att skapa tenanten vid första besöket (se lib/snajp/tenant.ts).
SNAJP_MASTER_API_KEY=snajp_master_...